<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <title>Hebben Gab en Anna al een Indonesische rijsttafel gegeten?</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    html, body {
      height: 100%;
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #000;
      color: #fff;
    }
    .container {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1rem;
    }
    h1 {
      font-size: clamp(2rem, 5vw, 4rem);
      margin-bottom: 2rem;
    }
    .answer {
      font-size: clamp(6rem, 20vw, 20rem);
      font-weight: bold;
      margin: 0;
    }
    .timer {
      margin-top: 2rem;
      font-size: clamp(1.2rem, 4vw, 2rem);
      opacity: 0.9;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Hebben Gab en Anna al een Indonesische rijsttafel gegeten?</h1>
    <div class="answer">NEE</div>
    <div class="timer" id="timer"></div>
  </div>

  <script>
    // Startmoment: nu
    const startDate = new Date();
    // Eindmoment: 100 dagen vanaf start
    const endDate = new Date(startDate.getTime() + 100 * 24 * 60 * 60 * 1000);

    const timerEl = document.getElementById('timer');

    function updateTimer() {
      const now = new Date();
      const diff = endDate - now;

      if (diff <= 0) {
        timerEl.textContent = 'De 100 dagen zijn voorbij.';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      timerEl.textContent = `Nog ${days} dagen, ${hours} uur, ${minutes} minuten en ${seconds} seconden`;
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  </script>
</body>
</html>
